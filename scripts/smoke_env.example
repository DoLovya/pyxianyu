# pyxianyu 1.x Smoke Harness 环境变量模板
# 复制为 .env.local 后填入真实值：
#   cp scripts/smoke_env.example .env.local
# 然后（可选）加载：
#   python scripts/smoke_1_0.py   # 若本机装有 python-dotenv 会自动加载 .env.local
#
# 注意 1：.env.local / .env 已在 .gitignore 中，请不要提交带真实 Cookie/商品ID 的副本！
# 注意 2：缺任一 env 对应用例自动标记 SKIP，不填也能看到 mock 模式的 shape 校验通过。

# ------------------------------------------------------------------
# 通用（影响全部用例）
# ------------------------------------------------------------------

# 闲鱼 Web 端完整 Cookie 字符串（抓包自 www.goofish.com）。
# 留空 → 所有 HTTP/WS 用例进入 mock 模式。
XY_COOKIE_STR=

# 可选：自定义 device_id。留空则根据 XY_COOKIE_STR 中的 unb 自动生成（或生成随机）。
XY_DEVICE_ID=

# 可选：HTTP 重试次数（默认 0 不重试；real 模式下设为 2 即可抗偶发 400600001/网络抖动）。
XY_HTTP_RETRY=0

# ------------------------------------------------------------------
# 商品擦亮用例（polish_item）
# ------------------------------------------------------------------

# 一个你自己账号下的在售商品 ID（不能是别人的）。留空 → 该用例 SKIP。
XY_TEST_ITEM_ID=

# ------------------------------------------------------------------
# 普通下单用例（place_order）
# 两层 opt-in：必须同时设置 XY_TEST_ORDER_ITEM_ID 并将 XY_RUN_ORDER_TESTS=1，
# 否则默认 SKIP，防止误生成真实未付款订单。
# ------------------------------------------------------------------

# 下单目标商品 ID（可以是别人在售的任意普通商品，建议选 1 元商品）。
XY_TEST_ORDER_ITEM_ID=

# 必须显式设为 1 才运行 place_order；未设 → 整体 SKIP。
XY_RUN_ORDER_TESTS=0

# ------------------------------------------------------------------
# WebSocket IM 域（ws_list_all_conversations）
# 必须显式设为 1 才运行（运行会建立公网 wss 连接，CI 默认关闭）。
# ------------------------------------------------------------------

# 显式开启 WS smoke；设为 1 才会连 wss-goofish.dingtalk.com
XY_RUN_LIVE_TESTS=0

# 可选：WS init() 超时秒数（整数；默认 12；建议 ≥10）。
XY_WS_TIMEOUT=12
